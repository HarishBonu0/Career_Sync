{
  "name": "unfold-backend",
  "version": "1.0.0",
  "description": "Unfold Course Platform Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node -r tsx/cjs src/db/migrate.ts",
